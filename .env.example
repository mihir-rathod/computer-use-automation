# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Required for `discover` (LLM-driven discovery run). Not required for `replay` or `pytest`.
# Get a free key at https://aistudio.google.com/apikey -- no billing needed, free-tier rate limits apply.
GEMINI_API_KEY=


# Where the platform finds the clinic. Default http://localhost:8100. To use the hosted one instead (it sleeps when idle; the platform waits for it to wake):
# CLINIC_BASE_URL=https://larkspur-clinic-ops.onrender.com

# Clinic target app (all optional).
# CLINIC_TEST_TOKEN=            # set on any shared/public deployment to lock /_test
# CLINIC_SESSION_IDLE_SECONDS=600
# CLINIC_DB_PATH=:memory:       # a file path persists state across restarts
