{
  "artifact_schema_version": "1.0",
  "capability_id": "meridian.balance_inquiry",
  "version": "1.0.0",
  "name": "Look up a member and read their balances",
  "description": "Covers both 'Member inquiry / selection' and 'Member record / balance' from the brief in one flow, mirroring how mockbank.member_balance_lookup bundles search+read rather than splitting them into two capabilities.",
  "target": {
    "app_id": "meridian",
    "surface_type": "web",
    "base_url": "https://web-sample.interface-hiring.com",
    "vendor_product": "meridian-core",
    "tenant_id": null
  },
  "preconditions": {
    "requires_capability": "meridian.signon",
    "note": "Assumes an authenticated operator session."
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "member_id": {
        "type": "string"
      }
    },
    "required": [
      "member_id"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "found",
          "not_found"
        ]
      },
      "member_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "first_share_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "first_share_balance": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "success_checkpoint": {
    "type": "text_present",
    "value": "SHARES / BALANCES",
    "target": null,
    "description": null
  },
  "steps": [
    {
      "step_id": "s1",
      "action": "navigate",
      "target": null,
      "params": {
        "url": "/members"
      },
      "output_binding": null,
      "checkpoint": {
        "type": "url_matches",
        "value": "**/members",
        "target": null,
        "description": null
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s2",
      "action": "type",
      "target": {
        "semantic_description": "textbox",
        "locators": [
          {
            "strategy": "role",
            "value": "textbox",
            "note": "Primary: accessible role + name, computed at discovery time."
          },
          {
            "strategy": "css",
            "value": "[name='q']",
            "note": "Fallback: no accessible name or id at discovery time -- the HTML name attribute is the only stable identifier this element has."
          }
        ]
      },
      "params": {
        "text": "{{member_id}}"
      },
      "output_binding": null,
      "checkpoint": {
        "type": "element_value_equals",
        "value": "{{member_id}}",
        "target": {
          "semantic_description": "textbox",
          "locators": [
            {
              "strategy": "role",
              "value": "textbox",
              "note": "Primary: accessible role + name, computed at discovery time."
            },
            {
              "strategy": "css",
              "value": "[name='q']",
              "note": "Fallback: no accessible name or id at discovery time -- the HTML name attribute is the only stable identifier this element has."
            }
          ]
        },
        "description": null
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s3",
      "action": "click",
      "target": {
        "semantic_description": "Search",
        "locators": [
          {
            "strategy": "role",
            "value": "button[name='Search']",
            "note": "Primary: accessible role + name, computed at discovery time."
          }
        ]
      },
      "params": {},
      "output_binding": null,
      "checkpoint": null,
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s4",
      "action": "click",
      "target": {
        "semantic_description": "Select",
        "locators": [
          {
            "strategy": "role",
            "value": "link[name='Select']",
            "note": "Primary: accessible role + name, computed at discovery time."
          }
        ]
      },
      "params": {},
      "output_binding": null,
      "checkpoint": {
        "type": "url_matches",
        "value": "**/members/{{member_id}}",
        "target": null,
        "description": null
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s5",
      "action": "extract",
      "target": {
        "semantic_description": "Member name",
        "locators": [
          {
            "strategy": "xpath",
            "value": "//td[normalize-space(text())='Name:']/following-sibling::td[1]",
            "note": "Hand-corrected, not discovered as-is -- discovery's own compute_target() used the cell's own literal text as its 'name' (cell[name='Lovelace, Ada']), since MERIDIAN's tables have no <th> at all for role/name to derive a stable label from (confirmed: plain <td> grids throughout, verified via the raw HTML). That locator only ever matches the exact member discovery happened to run against. Anchored to the adjacent label cell instead, verified against a real page with a different member."
          }
        ]
      },
      "params": {},
      "output_binding": "member_name",
      "checkpoint": null,
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s6",
      "action": "extract",
      "target": {
        "semantic_description": "First share ID",
        "locators": [
          {
            "strategy": "xpath",
            "value": "//tr[td[1][normalize-space(text())='Share ID']]/following-sibling::tr[1]/td[1]",
            "note": "Same fix as s5: anchored to the header row's own literal text ('Share ID'), then its first following data row's first cell -- works for any member regardless of how many shares they have, unlike the per-value locator discovery produced."
          }
        ]
      },
      "params": {},
      "output_binding": "first_share_id",
      "checkpoint": null,
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s7",
      "action": "extract",
      "target": {
        "semantic_description": "First share balance",
        "locators": [
          {
            "strategy": "xpath",
            "value": "//tr[td[1][normalize-space(text())='Share ID']]/following-sibling::tr[1]/td[3]",
            "note": "Same fix as s6, third column (Balance) of the same first data row."
          }
        ]
      },
      "params": {},
      "output_binding": "first_share_balance",
      "checkpoint": null,
      "risk_level": "safe",
      "idempotent": true
    }
  ],
