  "provenance": {
    "discovered_by": "gemini-flash-lite-latest + hand-corrected extraction locators",
    "discovery_run_id": "discovery_run_20260827T031155Z",
    "created_at": "2026-08-27T03:12:11.895131Z",
    "reviewed": true,
    "note": "Discovery finished cleanly in 7 steps, but its own extraction locators (s5-s7) used each cell's literal per-member text as the locator's accessible name -- correct for the member discovery ran against (100234), broken for anyone else. Corrected to XPath locators anchored to stable label/header text (see each step's note); verified by replaying against a different member (100987) after the fix."
  },
