{
  "artifact_schema_version": "1.0",
  "capability_id": "meridian.funds_transfer",
  "version": "1.0.0",
  "name": "Transfer funds between a member's shares",
  "description": "Moves money from one share to another for a given member, via MERIDIAN's entry -> review -> post confirmation flow. The final post step is irreversible and gated on human confirmation.",
  "target": {
    "app_id": "meridian",
    "surface_type": "web",
    "base_url": "https://web-sample.interface-hiring.com",
    "vendor_product": "meridian-core",
    "tenant_id": null
  },
  "preconditions": {
    "requires_capability": "meridian.signon",
    "note": "Assumes an authenticated operator session."
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "member_id": { "type": "string" },
      "from_share": { "type": "string", "description": "Exact share id, e.g. '100987-S0001-4'. Must not be a share on HOLD -- see business_outcomes.validation_error." },
      "to_share": { "type": "string", "description": "Exact share id, e.g. '100987-MMKT-5'." },
      "amount": { "type": "number" },
      "memo": { "type": "string" }
    },
    "required": ["member_id", "from_share", "to_share", "amount"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["posted", "not_found", "permission_denied", "validation_error"] },
      "confirmation_number": { "type": ["string", "null"] }
    },
    "required": ["status"]
  },
  "success_checkpoint": {
    "type": "text_present",
    "value": "TRANSFER POSTED",
    "description": "Provisional -- corrected once a real confirmed post has actually been observed (see Phase 0 verification run)."
  },
  "steps": [
    {
      "step_id": "s1",
      "action": "navigate",
      "params": { "url": "/members?next=transfer" },
      "checkpoint": { "type": "text_present", "value": "MEMBER INQUIRY" },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s2",
      "action": "type",
      "target": {
        "semantic_description": "Member number search field",
        "locators": [
          { "strategy": "role", "value": "textbox", "note": "No accessible name on this field; unambiguous only because it's the sole textbox on the search form." },
          { "strategy": "css", "value": "[name='q']", "note": "Fallback: the HTML name attribute, computed at discovery time." }
        ]
      },
      "params": { "text": "{{member_id}}" },
      "checkpoint": {
        "type": "element_value_equals",
        "target": {
          "semantic_description": "Member number search field",
          "locators": [
            { "strategy": "role", "value": "textbox" },
            { "strategy": "css", "value": "[name='q']" }
          ]
        },
        "value": "{{member_id}}"
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s3",
      "action": "click",
      "target": {
        "semantic_description": "Search",
        "locators": [
          { "strategy": "role", "value": "button[name='Search']", "note": "Computed at discovery time." }
        ]
      },
      "params": {},
      "checkpoint": { "type": "text_present", "value": "Select" },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s4",
      "action": "click",
      "target": {
        "semantic_description": "Select",
        "locators": [
          { "strategy": "role", "value": "link[name='Select']", "note": "Computed at discovery time; unambiguous because member-number search returns exactly one result row." }
        ]
      },
      "params": {},
      "checkpoint": { "type": "text_present", "value": "FUNDS TRANSFER" },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s5",
      "action": "select",
      "target": {
        "semantic_description": "From Share",
        "locators": [
          { "strategy": "role", "value": "combobox", "note": "No accessible name; ambiguous against the To Share combobox unless the CSS fallback is used." },
          { "strategy": "css", "value": "[name='from']", "note": "Fallback: HTML name attribute, computed at discovery time." }
        ]
      },
      "params": { "value": "{{from_share}}" },
      "checkpoint": {
        "type": "element_value_equals",
        "target": {
          "semantic_description": "From Share",
          "locators": [
            { "strategy": "css", "value": "[name='from']" }
          ]
        },
        "value": "{{from_share}}"
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s6",
      "action": "select",
      "target": {
        "semantic_description": "To Share",
        "locators": [
          { "strategy": "role", "value": "combobox", "note": "No accessible name; ambiguous against the From Share combobox unless the CSS fallback is used." },
          { "strategy": "css", "value": "[name='to']", "note": "Fallback: HTML name attribute, computed at discovery time." }
        ]
      },
      "params": { "value": "{{to_share}}" },
      "checkpoint": {
        "type": "element_value_equals",
        "target": {
          "semantic_description": "To Share",
          "locators": [
            { "strategy": "css", "value": "[name='to']" }
          ]
        },
        "value": "{{to_share}}"
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s7",
      "action": "type",
      "target": {
        "semantic_description": "Amount",
        "locators": [
          { "strategy": "role", "value": "textbox", "note": "No accessible name; ambiguous against the Memo field unless the CSS fallback is used." },
          { "strategy": "css", "value": "[name='amount']", "note": "Fallback: HTML name attribute, computed at discovery time." }
        ]
      },
      "params": { "text": "{{amount}}" },
      "checkpoint": {
        "type": "element_value_equals",
        "target": {
          "semantic_description": "Amount",
          "locators": [
            { "strategy": "css", "value": "[name='amount']" }
          ]
        },
        "value": "{{amount}}"
      },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s8",
      "action": "type",
      "target": {
        "semantic_description": "Memo",
        "locators": [
          { "strategy": "role", "value": "textbox", "note": "No accessible name; ambiguous against the Amount field unless the CSS fallback is used." },
          { "strategy": "css", "value": "[name='memo']", "note": "Fallback: HTML name attribute, computed at discovery time." }
        ]
      },
      "params": { "text": "{{memo}}" },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s9",
      "action": "click",
      "target": {
        "semantic_description": "Continue",
        "locators": [
          { "strategy": "role", "value": "button[name='Continue']", "note": "Computed at discovery time. current_path at click time is /members/{id}/transfer -- contains the domain keyword 'transfer', which is exactly why the risk classifier's domain-keyword tier only matches against semantic_description, not current_path (see safety/risk.py)." }
        ]
      },
      "params": {},
      "checkpoint": { "type": "text_present", "value": "CONFIRM FUNDS TRANSFER" },
      "risk_level": "safe",
      "idempotent": true
    },
    {
      "step_id": "s10",
      "action": "click",
      "target": {
        "semantic_description": "Post Transfer",
        "locators": [
          { "strategy": "role", "value": "button[name='Post Transfer']", "note": "Hand-authored, not discovered -- the discovery loop correctly cannot complete this step itself (blocked: irreversible action requires confirmation), the same reason mockbank.open_subaccount's final step was hand-written. Verified against the real review screen: 'CONFIRM FUNDS TRANSFER' page, warning text 'This will post immediately and cannot be reversed from this screen.', button labeled exactly 'Post Transfer'." }
        ]
      },
      "params": {},
      "checkpoint": { "type": "text_present", "value": "TRANSFER POSTED" },
      "risk_level": "irreversible",
      "idempotent": false
    },
    {
      "step_id": "s11",
      "action": "extract",
      "target": {
        "semantic_description": "Confirmation number",
        "locators": [
          { "strategy": "xpath", "value": "//td[normalize-space(text())='Confirmation:']/following-sibling::td[1]", "note": "The label and value are adjacent table cells with no id/class to key off (same legacy shape as the rest of this app) -- verified against a real posted transfer, whose success page showed 'Confirmation:' | 'CN480381' as sibling <td> cells. A plain text-anchor on 'Confirmation' matched the label cell itself, not the value, in the first verification run." }
        ]
      },
      "params": {},
      "output_binding": "confirmation_number",
      "risk_level": "safe",
      "idempotent": true
    }
  ],
  "error_handling": {
    "business_outcomes": [
      { "signal": { "type": "text_present", "value": "RECORD NOT FOUND" }, "outcome": "not_found", "output_field": "status" },
      { "signal": { "type": "text_present", "value": "No member records matched your search." }, "outcome": "not_found", "output_field": "status" },
      { "signal": { "type": "text_present", "value": "is not authorized to perform this function" }, "outcome": "permission_denied", "output_field": "status" },
      { "signal": { "type": "text_present", "value": "TRANSACTION REJECTED" }, "outcome": "validation_error", "output_field": "status" },
      { "signal": { "type": "text_present", "value": "could not be validated" }, "outcome": "validation_error", "output_field": "status" },
      { "signal": { "type": "text_present", "value": "Please correct the following" }, "outcome": "validation_error", "output_field": "status" }
    ],
    "recoverable": [
      { "signal": { "type": "text_present", "value": "YOUR SESSION HAS TIMED OUT" }, "action": "reauthenticate_and_resume" },
      { "signal": { "type": "text_present", "value": "SCHEDULED MAINTENANCE IN PROGRESS" }, "action": "retry", "max_attempts": 3, "backoff_ms": 1000 }
    ],
    "hard_failure_default": "stop_and_escalate"
  },
  "safety": {
    "risk_level": "state_changing",
    "requires_confirmation": true
  },
  "success_output_defaults": { "status": "posted" },
  "provenance": {
    "discovered_by": "gemini-flash-lite-latest + hand-written final step",
    "discovery_run_id": "discovery_run_20260827T021930Z",
    "created_at": "2026-08-27T00:00:00Z",
    "reviewed": true,
    "note": "Steps s1-s9 are exactly what discovery recorded (real resolved locators pulled from that run's evidence log), reaching the real CONFIRM FUNDS TRANSFER review screen. Discovery then correctly gave up at the Post Transfer button -- blocked by safety/policy.py's confirmation gate, which an unsupervised agent must never self-grant. s10/s11 are hand-authored, the same reasoning as mockbank.open_subaccount's irreversible step. Verified end to end via a real supervised replay: paused at s10, approved through the operator console with confirmed=true, actually posted (confirmation CN480381, see evidence/replay_run_20260827T025634Z) -- success_checkpoint 'TRANSFER POSTED' and s11's extraction locator were both corrected against that real page."
  }
}
